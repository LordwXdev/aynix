# copy this file to .env and fill it in

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/aynix?schema=public"

# two different long random strings (32+ characters). make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# in production the API refuses to start with a weak secret
JWT_SECRET="change_me"
JWT_REFRESH_SECRET="change_me_too"

# first admin account, created by: npm run seed
ADMIN_PHONE="+509..."
ADMIN_PASSWORD="change_me"

# ---- optional (defaults shown) ----
# PORT=3000
# ACCESS_TOKEN_TTL="15m"
# REFRESH_TOKEN_DAYS=30
# CORS_ORIGINS="*"              # e.g. "https://admin.aynix.ht,https://aynix.ht"
# COMMISSION_PERCENT=10
# DELIVERY_FEE=0                # flat fee per order, in HTG
# AUTH_RATE_LIMIT=30            # login tries per phone + IP every 15 min
# SMS_PROVIDER="console"        # "console" prints SMS, "none" turns them off

# ---- production ----
# REDIS_URL="redis://localhost:6379"   # needed with 2+ API servers (live updates + rate limits)
# DB_POOL_MAX=10                # database connections per server
# DB_STATEMENT_TIMEOUT_MS=10000 # stop queries that run too long
# REQUEST_TIMEOUT_MS=15000      # cut off requests that take too long
# LOG_LEVEL="info"              # debug | info | warn | error
# METRICS_TOKEN=""              # if set, /metrics needs "Authorization: Bearer <token>"
# JWT_SECRET_PREVIOUS=""        # only while changing JWT_SECRET (see docs/runbook.md)
# APP_VERSION=""                # shown in /health (defaults to package.json)

# ---- docker compose only ----
# POSTGRES_PASSWORD="aynix"     # password of the database container
# API_TAG="local"               # which image version to run (for deploys and rollbacks)
