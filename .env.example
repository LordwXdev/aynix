# copy this file to .env and fill it in

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aynix?schema=public"

# two different long random strings
JWT_SECRET="change_me"
JWT_REFRESH_SECRET="change_me_too"

# optional (defaults shown)
# PORT=3000
# ACCESS_TOKEN_TTL="15m"
# REFRESH_TOKEN_DAYS=30
# CORS_ORIGINS="*"            # e.g. "https://admin.aynix.ht,https://aynix.ht"
# COMMISSION_PERCENT=10
# DELIVERY_FEE=0              # flat fee per order, in HTG
# AUTH_RATE_LIMIT=30          # login/register/refresh tries per IP per 15 min
# SMS_PROVIDER="console"      # "console" prints SMS, "none" turns them off

# first admin account, created by: npm run seed
ADMIN_PHONE="+509..."
ADMIN_PASSWORD="change_me"
